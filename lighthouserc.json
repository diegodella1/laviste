{
  "ci": {
    "collect": {
      "startServerCommand": "node server.mjs",
      "startServerReadyPattern": "La Viste lista",
      "startServerReadyTimeout": 20000,
      "url": ["http://127.0.0.1:3080/", "http://127.0.0.1:3080/app"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["warn", {"maxNumericValue": 200}],
        "resource-summary:script:size": ["error", {"maxNumericValue": 160000}],
        "resource-summary:stylesheet:size": ["warn", {"maxNumericValue": 35000}],
        "resource-summary:total:size": ["warn", {"maxNumericValue": 260000}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
