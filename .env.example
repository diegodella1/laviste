# Opcional. Claves OpenAI se cargan desde Configuración web. IOL dormido por defecto (FEATURE_IOL=0).
FEATURE_IOL=0
HOST_PORT=3474
APP_ORIGIN=https://laviste.diegodella.ar
# Email del owner actual (Fase 1). Se normaliza a minúsculas al migrar. No rota la contraseña.
# OWNER_EMAIL=Diego@diegodella.ar
# Arranque local sin Docker, después de npm run setup:
# APP_PASSWORD_FILE=./secrets/app-password
# ADMIN_KEY_FILE=./secrets/admin_key
# MASTER_KEY_FILE=./secrets/master.key
# Login con Google (opcional). Archivos 0600 en secrets/. Si faltan, el botón no aparece y el server arranca.
# GOOGLE_CLIENT_ID_FILE=./secrets/google_client_id
# GOOGLE_CLIENT_SECRET_FILE=./secrets/google_client_secret
# GOOGLE_ALLOW_SUPERADMIN=0
# COOKIE_SECURE=false
# HOST=127.0.0.1
# PORT=3080
# DATA_DIR=./data
# Concurrencia IA (Fase 2 / PR 2D). Default 2 for the 768MB Pi container.
# HTTP that cannot get a slot (N global or 1 per user) fails immediately with 429 — requests are not queued.
# AI_CONCURRENCY=2
# SCHEDULER_JOBS_PER_HOUR=20
# RSS_DIGEST_TTL_MS=120000
