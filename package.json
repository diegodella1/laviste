{
  "name": "laviste",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node scripts/site-test.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "setup": "node scripts/setup.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
